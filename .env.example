# ---- Deploy ----
# Image tag for kappa9/fantaschedina. Set automatically by the deploy
# workflow to the commit SHA; falls back to 1.0.0 if unset.
APP_IMAGE_TAG=1.0.0

SPRING_PROFILES_ACTIVE=prod

# ---- Postgres ----
POSTGRES_DB=fantaschedina
POSTGRES_USER=fantaschedina
POSTGRES_PASSWORD=change-me

# ---- DataSource app ----
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/fantaschedina
SPRING_DATASOURCE_USERNAME=fantaschedina
SPRING_DATASOURCE_PASSWORD=change-me

# ---- App ----
APP_BASE_URL=https://fantaschedina.example.com
APP_MAIL_FROM=noreply@fantaschedina.example.com
APP_PORT=8080

# ---- Mail / SMTP ----
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=smtp-user
SPRING_MAIL_PASSWORD=smtp-password